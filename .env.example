# Runtime traffic uses Neon's pooled connection string. Use the direct,
# non-pooler URL only when running Drizzle migrations.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/pace?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/pace?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-unique-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Generate with: openssl rand -base64 32
# This is independent from BETTER_AUTH_SECRET and HMAC-protects invite secrets.
INVITATION_TOKEN_PEPPER=replace-with-a-separate-32-byte-secret
